{
  "name": "iloveslop",
  "version": "0.5.1",
  "description": "A rulebook that makes your AI coding agent produce the internet's favorite look. On purpose.",
  "type": "commonjs",
  "bin": {
    "iloveslop": "bin/slopcheck.js"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "slop.md",
    "DIRECTION.md",
    "skills",
    "AUDIT.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build:rules": "node scripts/build-rules.js",
    "check:rules": "node scripts/build-rules.js --check",
    "check:self": "node bin/slopcheck.js ./docs/index.html",
    "assets": "node scripts/shoot-assets.js",
    "demo": "node scripts/shoot-demo.js",
    "index": "node scripts/score-index.js",
    "index:build": "node scripts/build-index.js",
    "check:index": "node scripts/build-index.js --check"
  },
  "dependencies": {
    "puppeteer-core": "^25.18.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-slop",
    "agent-skills",
    "satire",
    "lint",
    "design"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srmdn/iloveslop.git"
  },
  "homepage": "https://srmdn.github.io/iloveslop/"
}
